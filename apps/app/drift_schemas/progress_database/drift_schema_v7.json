      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_progress\" (\"scope\" TEXT NOT NULL DEFAULT 'local://device', \"book_id\" TEXT NOT NULL, \"page\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, \"server_last_modified\" INTEGER NULL, \"pending_seq\" INTEGER NULL, PRIMARY KEY (\"scope\", \"book_id\"));"
