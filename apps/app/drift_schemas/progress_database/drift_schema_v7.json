        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_books_rows\" (\"id\" TEXT NOT NULL, \"series_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"number\" TEXT NOT NULL DEFAULT '', \"number_sort\" REAL NOT NULL DEFAULT 0.0, \"pages_count\" INTEGER NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"storage_kind\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"cover_thumb_path\" TEXT NULL, \"mount_root_id\" TEXT NULL, \"source_relative_path\" TEXT NULL, \"source_modified_ms\" INTEGER NULL, \"is_cloud_placeholder\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_cloud_placeholder\" IN (0, 1)), \"release_date\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
