      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_queue_entries\" (\"scope\" TEXT NOT NULL DEFAULT '', \"book_id\" TEXT NOT NULL, \"series_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"number\" TEXT NOT NULL DEFAULT '', \"pages_count\" INTEGER NOT NULL, \"state\" TEXT NOT NULL, \"done\" INTEGER NOT NULL DEFAULT 0, \"total\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"scope\", \"book_id\"));"
