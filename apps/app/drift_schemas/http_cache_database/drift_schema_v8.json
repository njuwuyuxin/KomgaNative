    {
      "name": "cached_responses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_responses\" (\"scope\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"body\" BLOB NOT NULL, \"last_used_seq\" INTEGER NOT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), PRIMARY KEY (\"scope\", \"url\"));"
        }
      ]
    },
    {
      "name": "downloaded_books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"downloaded_books\" (\"scope\" TEXT NOT NULL DEFAULT '', \"book_id\" TEXT NOT NULL, \"series_id\" TEXT NOT NULL, \"book_name\" TEXT NOT NULL DEFAULT '', \"page_count\" INTEGER NOT NULL, \"bytes\" INTEGER NOT NULL, \"saved_at\" INTEGER NOT NULL, PRIMARY KEY (\"scope\", \"book_id\"));"
        }
      ]
    },
